// documentation: https://zed.dev/docs/configuring-zed
{
  "show_edit_predictions": true,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "disabled_globs": ["**/*.md", "**/*.csv", "**/*.tsv","**/settings.json", "**/*.log"]
  },
  "edit_predictions_disabled_in": ["comment"],
  "assistant": {
    "version": "2",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest"
    }
  },
  "formatter": {
    "language_server": {
      "name": "biome",
    }
  },
  "code_actions_on_format": {
    "source.fixAll.biome": true,
    "source.organizeImports": true
  }, 
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      }
    },
  },
  "use_autoclose": false,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "theme": {
    "name": "theme",
    "light": "Catppuccin Latte",
    "dark": "Dracula"
  },
  "buffer_font_size": 13.0,
  "buffer_font_family": "Recursive Sans Linear Static",
  "buffer_font_features": {
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss08": true,
    "ss20": true,
    "pnum": true
  },
  "tabs": {
    "git_status": true
  },
  "terminal": {
    "font_family": "SF Mono",
    "font_size": 12,
    "default_height": 90,
    "shell": {
      "with_arguments": {
        "program": "zsh",
        "args": ["-f"]
      }
    }
  },
  "gutter": {
    "line_numbers": false
  },
  "project_panel": { "dock": "right" },
  "notification_panel": { "button": false, "dock": "bottom" },
  "collaboration_panel": { "button": false }
}
