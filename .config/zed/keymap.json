[
  {
    "bindings": {
      "cmd-h": "project_symbols::Toggle",
      "cmd-k": "command_palette::Toggle",
      "cmd-t": "workspace::NewFile"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-n": "workspace::NewWindow",
      "cmd-s s": "workspace::SaveWithoutFormat",
      "cmd-s cmd-s": "workspace::SaveWithoutFormat",
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-r": "editor::Rename",
      "cmd-o": "outline::Toggle",
    }
  },
  // replace all cmd-k prefixes
  {
    "context": "Pane",
    "bindings": {
      "cmd-k e": null,
      "cmd-k t": null,
      "cmd-k u": null,
      "cmd-k cmd-w": null,
      "cmd-k shift-enter": null,
      "cmd-k up": null,
      "cmd-k down": null,
      "cmd-k left": null,
      "cmd-k right": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-k cmd-q": null,
      "cmd-k q": null,
      "cmd-k z": null,
      "cmd-k cmd-d": null,
      "cmd-k ctrl-cmd-d": null,
      "cmd-k cmd-i": null,
      "cmd-k cmd-l": null,
      "cmd-k cmd-[": null,
      "cmd-k cmd-]": null,
      "cmd-k cmd-1": null,
