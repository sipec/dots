{
  "diffEditor.codeLens": true,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.cursorBlinking": "smooth",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "Recursive Sans Linear Static, SF Mono Regular, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": "'dlig', 'ss01', 'ss02', 'ss08', 'ss20', 'pnum'",
  "editor.fontSize": 14,
  "editor.fontWeight": 400,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.fontFamily": "SF Mono Regular, Menlo, Monaco, 'Courier New', monospace",
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "editor.suggest.preview": true,
  "editor.tabSize": 2,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.showExpandedAbbreviation": "never",
  "emmet.triggerExpansionOnTab": true,
  "eslint.lintTask.enable": true,
  "eslint.rules.customizations": [
    {
      "rule": "*",
      "severity": "info"
    }
  ],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.exclude": {
    "node_modules": true
  },
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "plaintext": false,
    "typescriptreact": true,
    "yaml": true
  },
  "gitlens.advanced.fileHistoryFollowsRenames": true,
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true
  },
  "gitlens.autolinks": [
    {
      "prefix": "MAN-",
      "url": "https://linear.app/manifoldmarkets/issue/MAN-<num>"
    }
  ],
  "gitlens.blame.ignoreWhitespace": true,
  "gitlens.codeLens.enabled": false,
  "gitlens.graph.dimMergeCommits": true,
  "gitlens.graph.minimap.additionalTypes": ["localBranches", "stashes", "tags"],
  "gitlens.hovers.annotations.enabled": false,
  "gitlens.hovers.changesDiff": "hunk",
  "gitlens.statusBar.enabled": false,
  "inline-parameters.enabled": false,
  "inline-parameters.hideSingleParameters": true,
  "json.schemas": [],
  "scm.diffDecorationsIgnoreTrimWhitespace": "inherit",
  "search.exclude": {
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true
  },
  "svelte.enable-ts-plugin": true,
  "svg.preview.mode": "svg",
  "tailwindCSS.emmetCompletions": true,
  "terminal.integrated.fontFamily": "SF Mono Regular, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.fontSize": 12,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": true,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Noctis Lilac",
  "workbench.commandPalette.experimental.suggestCommands": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.preferredDarkColorTheme": "Noctis Viola",
  "workbench.preferredLightColorTheme": "Noctis Lilac",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none"
}
